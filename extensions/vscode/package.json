{
  "name": "codecity",
  "displayName": "CodeCity 3D Viewer",
  "description": "Explore any codebase as an interactive 3D code city inside VS Code. Classes and modules become buildings, folders become districts, and imports become streets — for JavaScript, TypeScript, Python, Java, C/C++, C#, Go, Rust, Qt and more.",
  "version": "0.4.0",
  "publisher": "Amin-Tgz",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amin-Tgz/CodeCity.git"
  },
  "homepage": "https://github.com/Amin-Tgz/CodeCity#readme",
  "bugs": {
    "url": "https://github.com/Amin-Tgz/CodeCity/issues"
  },
  "keywords": [
    "code visualization",
    "3d",
    "architecture",
    "codebase",
    "dependencies",
    "city",
    "tree-sitter",
    "metrics"
  ],
  "galleryBanner": {
    "color": "#101c2b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Education",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:codecity.open",
    "onCommand:codecity.openInBrowser"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codecity",
          "title": "CodeCity",
          "icon": "media/codecity-activity.svg"
        }
      ]
    },
    "views": {
      "codecity": [
        {
          "id": "codecity.home",
          "name": "CodeCity",
          "type": "webview",
          "icon": "media/codecity-activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codecity.open",
        "title": "Open 3D View",
        "category": "CodeCity",
        "description": "Analyze the current folder and open its 3D code city in a VS Code tab.",
        "icon": "$(globe)"
      },
      {
        "command": "codecity.openInBrowser",
        "title": "Open in External Browser",
        "category": "CodeCity",
        "description": "Analyze the current folder and open its 3D code city in your default browser.",
        "icon": "$(browser)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codecity.open"
        },
        {
          "command": "codecity.openInBrowser"
        }
      ],
      "explorer/context": [
        {
          "command": "codecity.open",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "codecity.open",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "CodeCity",
      "properties": {
        "codecity.target": {
          "type": "string",
          "default": "webview",
          "enum": [
            "webview",
            "browser"
          ],
          "enumDescriptions": [
            "Open CodeCity in an integrated VS Code editor tab.",
            "Open CodeCity in your default external web browser."
          ],
          "markdownDescription": "Where CodeCity opens. **VS Code tab** keeps the city inside the editor; **External browser** opens it in a separate window. You can also choose this each time from the CodeCity activity-bar view."
        },
        "codecity.language": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "es",
            "fr",
            "de",
            "zh",
            "ja",
            "ar",
            "fa"
          ],
          "enumDescriptions": [
            "English",
            "Español (Spanish)",
            "Français (French)",
            "Deutsch (German)",
            "中文 (Chinese)",
            "日本語 (Japanese)",
            "العربية (Arabic)",
            "فارسی (Persian)"
          ],
          "markdownDescription": "Interface language for the CodeCity 3D view. The CodeCity activity-bar view lets you change it before opening."
        }
      }
    }
  }
}
