# Build a Linux x64 executable without installing build tools on the host.
FROM node:22.16.0-bookworm-slim AS builder
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY server ./server
COPY scripts ./scripts
COPY src ./src
COPY vendor ./vendor
COPY assets ./assets
COPY tests ./tests
COPY index.html styles.css ./
RUN npm test && npm run build:binary && ./dist/codecity --help
FROM scratch AS artifact
COPY --from=builder /build/dist/codecity /codecity-linux-x64
